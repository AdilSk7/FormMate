{
  "manifest_version": 3,
  "name": "FormMate – Smart Autofill",
  "version": "1.0.0",
  "description": "Smart, privacy-first form autofill for job applications and Google Forms using your saved personal data and learned questions.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FormMate – Smart Autofill"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ]
}
